mission_subtitle [pos="730,320!", shape=plain, fixedsize=false, fontname="Arial", fontsize=12, fontcolor="#64748B", label="Event-driven mission decisions run separately from fast onboard flight control."];
coverage [pos="260,190!", width=5.416666666666667, height=2.361111111111111, color="#0F766E", fillcolor="#F0FDFA", label=<<TABLE WIDTH="362" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT COLOR="#0F766E" POINT-SIZE="15"><B>COVERAGE LEDGER</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="13">Search patches + completed strips<BR ALIGN="LEFT"/>Last observation time + confidence</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="13">Record evidence and verified outcomes.<BR ALIGN="LEFT"/>Keep detections and deliveries distinct.</FONT></TD></TR></TABLE>>];
priority [pos="730,190!", width=5.416666666666667, height=2.361111111111111, color="#0F766E", fillcolor="#F0FDFA", label=<<TABLE WIDTH="362" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT COLOR="#0F766E" POINT-SIZE="15"><B>PRIORITY + REVISITS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="13">Urgent reports + high-risk villages<BR ALIGN="LEFT"/>Stale areas + uncertain detections</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="13">Update priorities as events arrive.<BR ALIGN="LEFT"/>Schedule verification and revisits.</FONT></TD></TR></TABLE>>];
