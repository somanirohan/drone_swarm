radio [pos="730,590!", width=5.416666666666667, height=4.305555555555555, color="#2563EB", fillcolor="#EFF6FF", label=<<TABLE WIDTH="362" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT COLOR="#2563EB" POINT-SIZE="15"><B>02  STATE + INTENT SHARING</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="13">ID · timestamp · coordinate frame<BR ALIGN="LEFT"/>Position · velocity · uncertainty</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="13">Short trajectory + validity<BR ALIGN="LEFT"/>Health · energy · task progress</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="13">Neighbors: collision-relevant intent<BR ALIGN="LEFT"/>Coordinator: observations and progress</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="13">Prioritize critical messages.<BR ALIGN="LEFT"/>Keep video local / stream selectively.</FONT></TD></TR></TABLE>>];
failure [pos="1200,590!", width=5.416666666666667, height=4.305555555555555, color="#BE123C", fillcolor="#FFF1F2", label=<<TABLE WIDTH="362" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT COLOR="#BE123C" POINT-SIZE="15"><B>03  FAILURE + WORK RECOVERY</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="13">Missing heartbeat → unreachable.<BR ALIGN="LEFT"/>Retain last position, task and coverage.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="13">Local sensing + onboard contingencies<BR ALIGN="LEFT"/>handle immediate flight hazards.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="13">Resolve task ownership safely.<BR ALIGN="LEFT"/>Reassign only unfinished search strips.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="13">Verify uncertain deliveries.<BR ALIGN="LEFT"/>Mechanical crashes may be unavoidable.</FONT></TD></TR></TABLE>>];
planner -> radio [pos="s,730,860 e,730,745 730.0,852.0 730.0,844.0 730.0,761.0 730.0,753.0", color="#2563EB", dir=both];
