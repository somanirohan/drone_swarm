estimate [pos="455,940!", width=3.0555555555555554, height=2.2222222222222223, color="#7C3AED", fillcolor="#FAF8FF", label=<<TABLE WIDTH="192" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT COLOR="#7C3AED" POINT-SIZE="15"><B>STATE ESTIMATION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="13">Fuse measurements</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="13">Position · velocity · attitude<BR ALIGN="LEFT"/>Uncertainty + obstacle map</FONT></TD></TR></TABLE>>];
planner [pos="730,940!", width=3.0555555555555554, height=2.2222222222222223, color="#7C3AED", fillcolor="#FAF8FF", label=<<TABLE WIDTH="192" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT COLOR="#7C3AED" POINT-SIZE="15"><B>LOCAL PLANNER</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="13">Goal + nearby obstacles<BR ALIGN="LEFT"/>Neighbor trajectories</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="13">Plan → execute → replan<BR ALIGN="LEFT"/>Receding horizon</FONT></TD></TR></TABLE>>];
control [pos="1005,940!", width=3.0555555555555554, height=2.2222222222222223, color="#7C3AED", fillcolor="#FAF8FF", label=<<TABLE WIDTH="192" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT COLOR="#7C3AED" POINT-SIZE="15"><B>FLIGHT CONTROL</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="13">Position → velocity<BR ALIGN="LEFT"/>Attitude → angular rate</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="13">Track trajectory<BR ALIGN="LEFT"/>Apply onboard failsafes</FONT></TD></TR></TABLE>>];
