<?xml version='1.0' encoding='utf-8'?>
<mxGraphModel dx="1500" dy="940" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="940" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="2 / COMMUNICATION: STATE, INTENT AND EVENTS" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#0f172a;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="52" as="geometry" /></mxCell><mxCell id="n2" value="Communication supports coordination. Onboard stabilization never waits for a cloud response." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#475569;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1420" height="46" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;Drone A&lt;/b&gt;&lt;br&gt;&lt;br&gt;Local sensors + own state estimate&lt;br&gt;Current task + short future trajectory&lt;br&gt;Onboard control and contingency" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="400" height="170" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Nearby Drone B / C / …&lt;/b&gt;&lt;br&gt;&lt;br&gt;Receive relevant neighbor intent&lt;br&gt;Predict separation over time&lt;br&gt;Replan with local sensing" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="1060" y="180" width="400" height="170" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;Shared compact message&lt;/b&gt;&lt;br&gt;&lt;br&gt;ID + timestamp + coordinate frame&lt;br&gt;Position + velocity + uncertainty&lt;br&gt;Planned trajectory + validity&lt;br&gt;Health + energy estimate + task" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="550" y="155" width="400" height="220" as="geometry" /></mxCell><mxCell id="n6" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;publish&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#2563eb;labelBackgroundColor=#ffffff;" edge="1" source="n3" target="n5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n7" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;subscribe&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#2563eb;labelBackgroundColor=#ffffff;" edge="1" source="n5" target="n4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n8" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;own intent&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#2563eb;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" source="n4" target="n5" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="415" /><mxPoint x="750" y="415" /></Array></mxGeometry></mxCell><mxCell id="n9" value="&lt;b&gt;Local field radio / gateway&lt;/b&gt;&lt;br&gt;&lt;br&gt;Direct radio, routed mesh or LTE&lt;br&gt;Prioritize command / alert traffic&lt;br&gt;Bound neighbor discovery + message load&lt;br&gt;Persist critical events while offline" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="550" y="495" width="400" height="180" as="geometry" /></mxCell><mxCell id="n10" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;status +&lt;br&gt;observations&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#2563eb;labelBackgroundColor=#ffffff;" edge="1" source="n5" target="n9" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n11" value="&lt;b&gt;Field mission coordinator&lt;/b&gt;&lt;br&gt;&lt;br&gt;Task progress + aircraft availability&lt;br&gt;Confirmed detections + coverage&lt;br&gt;New tasks / assignment changes&lt;br&gt;Scope, identity and expiry checks" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="495" width="400" height="180" as="geometry" /></mxCell><mxCell id="n12" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;events&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;" edge="1" source="n9" target="n11" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n13" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;mission&lt;br&gt;commands&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" source="n11" target="n9" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="725" /><mxPoint x="750" y="725" /></Array></mxGeometry></mxCell><mxCell id="n14" value="&lt;b&gt;Separate media path&lt;/b&gt;&lt;br&gt;&lt;br&gt;Record imagery onboard&lt;br&gt;Send detections + evidence references&lt;br&gt;Stream selected cameras only&lt;br&gt;Do not flood control links with video" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="1060" y="495" width="400" height="180" as="geometry" /></mxCell><mxCell id="n15" value="&lt;b&gt;Stale-data handling&lt;/b&gt;&lt;br&gt;&lt;br&gt;Late neighbor messages increase uncertainty. Reject expired intent and follow the validated local contingency when safe planning is no longer possible.&lt;br&gt;A radio mesh supplies connectivity; algorithms, timing checks and local sensing supply coordination." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="1420" height="95" as="geometry" /></mxCell><mxCell id="n16" value="Research basis: EGO-Swarm (arxiv.org/abs/2011.04183); Swarm-LIO2 (arxiv.org/abs/2409.17798). Topology and link capacity are design choices requiring measurement." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#64748b;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="875" width="1420" height="48" as="geometry" /></mxCell></root></mxGraphModel>