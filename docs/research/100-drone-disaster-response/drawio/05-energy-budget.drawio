<?xml version='1.0' encoding='utf-8'?>
<mxGraphModel dx="1500" dy="1060" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="1060" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="4 / BATTERY: MEASURE, PREDICT, FILTER, ROTATE" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#0f172a;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="52" as="geometry" /></mxCell><mxCell id="n2" value="Use a conservative energy estimate for the route and task. Battery percentage alone is not mission feasibility." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#475569;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1420" height="46" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;Measure usable energy&lt;/b&gt;&lt;br&gt;&lt;br&gt;Calibrated voltage + current sensing&lt;br&gt;Consumed energy ≈ integral of V × I&lt;br&gt;Capacity / temperature / ageing&lt;br&gt;Estimate uncertainty" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="410" height="170" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Predict required energy&lt;/b&gt;&lt;br&gt;&lt;br&gt;Travel to task + perform work&lt;br&gt;Reach safe recovery + pad wait&lt;br&gt;Payload / wind / route conditions&lt;br&gt;Contingency reserve" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="545" y="170" width="410" height="170" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;Feasibility test&lt;/b&gt;&lt;br&gt;&lt;br&gt;Usable remaining energy ≥&lt;br&gt;travel + work + recovery + reserve&lt;br&gt;Reject infeasible assignments&lt;br&gt;Recompute during the sortie" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="1050" y="170" width="410" height="170" as="geometry" /></mxCell><mxCell id="n6" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;current&lt;br&gt;estimate&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#b45309;labelBackgroundColor=#ffffff;" edge="1" source="n3" target="n4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n7" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;conservative&lt;br&gt;budget&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#b45309;labelBackgroundColor=#ffffff;" edge="1" source="n4" target="n5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;Illustrative allocation&lt;/b&gt;&lt;br&gt;&lt;br&gt;D8: 80 Wh usable; task needs 90 Wh&lt;br&gt;→ reject this assignment&lt;br&gt;D23: 80 Wh usable; task needs 65 Wh&lt;br&gt;→ eligible if other constraints pass" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="410" height="175" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;Plan continuity&lt;/b&gt;&lt;br&gt;&lt;br&gt;Assign replacement before recovery&lt;br&gt;Reserve safe landing / pad capacity&lt;br&gt;Check return route and alternate&lt;br&gt;Notify allocator of declining margin" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="545" y="440" width="410" height="175" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;Onboard fallback&lt;/b&gt;&lt;br&gt;&lt;br&gt;Energy margin triggers recovery&lt;br&gt;Battery failsafe remains local&lt;br&gt;Navigation / weather may change plan&lt;br&gt;Never rely on cloud response" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="1050" y="440" width="410" height="175" as="geometry" /></mxCell><mxCell id="n11" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;during flight&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c3aed;labelBackgroundColor=#ffffff;" edge="1" source="n5" target="n10" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n12" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;eligibility /&lt;br&gt;recovery&lt;br&gt;forecast&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;exitX=0;exitY=1;entryX=0.5;entryY=0;" edge="1" source="n5" target="n9" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="390" /><mxPoint x="750" y="390" /></Array></mxGeometry></mxCell><mxCell id="n13" value="&lt;b&gt;Ground rotation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Recover → inspect → swap pack&lt;br&gt;Cool / charge → verify → relaunch&lt;br&gt;Track pack identity and health&lt;br&gt;Charging power and crew are finite" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="545" y="735" width="410" height="170" as="geometry" /></mxCell><mxCell id="n14" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;sortie&lt;br&gt;handoff&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#b45309;labelBackgroundColor=#ffffff;" edge="1" source="n9" target="n13" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n15" value="Illustrative numbers are not specifications. Reserve and flight envelope must be validated for the actual aircraft." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#475569;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="1420" height="30" as="geometry" /></mxCell><mxCell id="n16" value="Sources: ArduPilot battery-monitor documentation; arxiv.org/abs/2209.06308 (uncertain energy and recharge allocation)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#64748b;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="995" width="1420" height="48" as="geometry" /></mxCell></root></mxGraphModel>