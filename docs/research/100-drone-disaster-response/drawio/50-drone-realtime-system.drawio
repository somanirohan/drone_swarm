<mxfile host="app.diagrams.net" modified="2026-10-10T00:00:00.000Z" agent="drawio-mcp diagram authoring" version="32.4.1" compressed="false"><diagram id="swarm-page-1" name="01 Overview"><mxGraphModel dx="1600" dy="1170" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1170" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="50-DRONE SWARM / REAL-TIME SYSTEM" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#0f172a;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="52" as="geometry" /></mxCell><mxCell id="n2" value="Five cooperating mechanisms. Flight stays local; mission coordination reacts to events. No LLM is required." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#475569;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1520" height="46" as="geometry" /></mxCell><mxCell id="n3" value="1  ON EVERY AIRCRAFT — continuous closed-loop control" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;container=1;collapsible=0;fillColor=#faf5ff;swimlaneFillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#7c3aed;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="1520" height="335" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Sensors&lt;/b&gt;&lt;br&gt;&lt;br&gt;IMU + GNSS&lt;br&gt;Camera / depth&lt;br&gt;Voltage + current" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="25" y="85" width="270" height="145" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;State estimation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sensor fusion&lt;br&gt;Position + velocity + attitude&lt;br&gt;Uncertainty + local map" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="325" y="85" width="270" height="145" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;Trajectory planning&lt;/b&gt;&lt;br&gt;&lt;br&gt;Predict nearby paths&lt;br&gt;Optimize a short horizon&lt;br&gt;Replan as inputs change" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="625" y="85" width="270" height="145" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;Flight controllers&lt;/b&gt;&lt;br&gt;&lt;br&gt;Position → velocity&lt;br&gt;Attitude → angular rate&lt;br&gt;Track desired trajectory" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="925" y="85" width="270" height="145" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;Actuators + motion&lt;/b&gt;&lt;br&gt;&lt;br&gt;Allocate motor outputs&lt;br&gt;Aircraft moves&lt;br&gt;Sensors measure again" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="1225" y="85" width="270" height="145" as="geometry" /></mxCell><mxCell id="n9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c3aed;labelBackgroundColor=#ffffff;" edge="1" source="n4" target="n5" parent="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c3aed;labelBackgroundColor=#ffffff;" edge="1" source="n5" target="n6" parent="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c3aed;labelBackgroundColor=#ffffff;" edge="1" source="n6" target="n7" parent="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c3aed;labelBackgroundColor=#ffffff;" edge="1" source="n7" target="n8" parent="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n13" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;physical&lt;br&gt;feedback&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c3aed;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" source="n8" target="n4" parent="n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1360" y="280" /><mxPoint x="160" y="280" /></Array></mxGeometry></mxCell><mxCell id="n14" value="2  COMMUNICATION" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;container=1;collapsible=0;fillColor=#eff6ff;swimlaneFillColor=#ffffff;strokeColor=#2563eb;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#2563eb;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="555" width="365" height="470" as="geometry" /></mxCell><mxCell id="n15" value="5  TASKS + COVERAGE" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;container=1;collapsible=0;fillColor=#f0fdfa;swimlaneFillColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#0f766e;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="425" y="555" width="365" height="470" as="geometry" /></mxCell><mxCell id="n16" value="4  ENERGY + ROTATION" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;container=1;collapsible=0;fillColor=#fffbeb;swimlaneFillColor=#ffffff;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#b45309;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="810" y="555" width="365" height="470" as="geometry" /></mxCell><mxCell id="n17" value="3  FAILURE RECOVERY" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;container=1;collapsible=0;fillColor=#fff1f2;swimlaneFillColor=#ffffff;strokeColor=#be123c;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#be123c;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="1195" y="555" width="365" height="470" as="geometry" /></mxCell><mxCell id="n18" value="&lt;b&gt;Compact state + intent&lt;/b&gt;&lt;br&gt;&lt;br&gt;ID + timestamp&lt;br&gt;Position / velocity + uncertainty&lt;br&gt;Short planned trajectory&lt;br&gt;Health + energy + task" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n14"><mxGeometry x="20" y="70" width="325" height="180" as="geometry" /></mxCell><mxCell id="n19" value="&lt;b&gt;Radio links&lt;/b&gt;&lt;br&gt;&lt;br&gt;Neighbors: collision-relevant data&lt;br&gt;Gateway: status + observations&lt;br&gt;Video: local / selected upload&lt;br&gt;Reject stale state; bound traffic" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n14"><mxGeometry x="20" y="280" width="325" height="145" as="geometry" /></mxCell><mxCell id="n20" value="&lt;b&gt;Event-driven allocator&lt;/b&gt;&lt;br&gt;&lt;br&gt;Divide area into search patches&lt;br&gt;Rank urgency + observation age&lt;br&gt;Filter capability + energy&lt;br&gt;Assign remaining feasible work" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n15"><mxGeometry x="20" y="70" width="325" height="180" as="geometry" /></mxCell><mxCell id="n21" value="&lt;b&gt;Outcome + coverage ledger&lt;/b&gt;&lt;br&gt;&lt;br&gt;Track completed search strips&lt;br&gt;Record detection confidence&lt;br&gt;Revisit uncertain observations&lt;br&gt;Prevent conflicting assignments" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n15"><mxGeometry x="20" y="280" width="325" height="145" as="geometry" /></mxCell><mxCell id="n22" value="&lt;b&gt;Energy feasibility&lt;/b&gt;&lt;br&gt;&lt;br&gt;Remaining usable energy ≥&lt;br&gt;travel + work + recovery&lt;br&gt;+ contingency reserve&lt;br&gt;Account for wind / payload" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n16"><mxGeometry x="20" y="70" width="325" height="180" as="geometry" /></mxCell><mxCell id="n23" value="&lt;b&gt;Maintain coverage&lt;/b&gt;&lt;br&gt;&lt;br&gt;Schedule replacement before return&lt;br&gt;Reserve recovery / pad capacity&lt;br&gt;Swap, cool, charge and inspect&lt;br&gt;Onboard battery failsafe" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n16"><mxGeometry x="20" y="280" width="325" height="145" as="geometry" /></mxCell><mxCell id="n24" value="&lt;b&gt;Detect + classify&lt;/b&gt;&lt;br&gt;&lt;br&gt;Missing heartbeat → unreachable&lt;br&gt;Known fault → degraded / failed&lt;br&gt;Retain last position and task&lt;br&gt;Local aircraft handle hazards" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fff1f2;strokeColor=#be123c;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n17"><mxGeometry x="20" y="70" width="325" height="180" as="geometry" /></mxCell><mxCell id="n25" value="&lt;b&gt;Recover unfinished work&lt;/b&gt;&lt;br&gt;&lt;br&gt;Resolve execution conflict first&lt;br&gt;Reallocate unfinished search&lt;br&gt;Verify uncertain delivery outcome&lt;br&gt;Lost capacity ≠ guaranteed rescue" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fff1f2;strokeColor=#be123c;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n17"><mxGeometry x="20" y="280" width="325" height="145" as="geometry" /></mxCell><mxCell id="n26" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;neighbor&lt;br&gt;trajectories&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#2563eb;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.15;entryY=1;" edge="1" source="n18" target="n6" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="515" /><mxPoint x="790" y="515" /></Array></mxGeometry></mxCell><mxCell id="n27" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;assigned goal&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.85;entryY=1;" edge="1" source="n20" target="n6" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="605" y="495" /><mxPoint x="865" y="495" /></Array></mxGeometry></mxCell><mxCell id="n28" value="ENERGY AND FAILURE EVENTS UPDATE ELIGIBILITY; THE FLIGHT LOOP KEEPS RUNNING" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#0f172a;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1045" width="1520" height="36" as="geometry" /></mxCell><mxCell id="n29" value="Architecture proposal. Exact rates, radio capacity and safety behavior require platform validation. Research: PX4, Crazyswarm, EGO-Swarm, CBBA and energy-constrained surveillance." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#64748b;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1105" width="1520" height="48" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="swarm-page-2" name="02 Onboard control"><mxGraphModel dx="1500" dy="940" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="940" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="1 / ONBOARD FEEDBACK AND LOCAL PLANNING" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#0f172a;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="52" as="geometry" /></mxCell><mxCell id="n2" value="Every aircraft executes this stack independently. A task is a goal; motor commands come from local control." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#475569;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1420" height="46" as="geometry" /></mxCell><mxCell id="n3" value="AIRCRAFT COMPUTE BOUNDARY" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;container=1;collapsible=0;fillColor=#faf5ff;swimlaneFillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#7c3aed;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="1420" height="580" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Sensor acquisition&lt;/b&gt;&lt;br&gt;&lt;br&gt;IMU: acceleration + angular rate&lt;br&gt;GNSS / vision: position cues&lt;br&gt;Depth / camera: obstacles" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="30" y="85" width="300" height="145" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;State estimator&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fuse imperfect measurements&lt;br&gt;Estimate position, velocity, attitude&lt;br&gt;Track uncertainty and sensor health" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="380" y="85" width="300" height="145" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;Local trajectory optimizer&lt;/b&gt;&lt;br&gt;&lt;br&gt;Goal + local map + neighbor paths&lt;br&gt;Short-horizon feasible trajectory&lt;br&gt;Execute a portion, then replan" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="730" y="85" width="300" height="145" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;Neighbor exchange&lt;/b&gt;&lt;br&gt;&lt;br&gt;Receive planned trajectories&lt;br&gt;Timestamp + coordinate frame&lt;br&gt;Age and uncertainty matter" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="1080" y="85" width="300" height="145" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;Cascaded flight controller&lt;/b&gt;&lt;br&gt;&lt;br&gt;Position error → desired velocity&lt;br&gt;Velocity error → thrust / attitude&lt;br&gt;Attitude error → angular rate" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="730" y="320" width="300" height="150" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;Rate loop + motor allocation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Angular-rate tracking corrections&lt;br&gt;Translate thrust / torque to motors&lt;br&gt;Physical motion closes the loop" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="380" y="320" width="300" height="150" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;Independent safety logic&lt;/b&gt;&lt;br&gt;&lt;br&gt;Battery / position / link health&lt;br&gt;Configured hold / recovery / land&lt;br&gt;Mission-specific contingency" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="30" y="320" width="300" height="150" as="geometry" /></mxCell><mxCell id="n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c3aed;labelBackgroundColor=#ffffff;" edge="1" source="n4" target="n5" parent="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c3aed;labelBackgroundColor=#ffffff;" edge="1" source="n5" target="n6" parent="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c3aed;labelBackgroundColor=#ffffff;" edge="1" source="n7" target="n6" parent="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c3aed;labelBackgroundColor=#ffffff;" edge="1" source="n6" target="n8" parent="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c3aed;labelBackgroundColor=#ffffff;" edge="1" source="n8" target="n9" parent="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n16" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;motion →&lt;br&gt;measurements&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c3aed;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" source="n9" target="n4" parent="n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="490" /><mxPoint x="355" y="270" /><mxPoint x="180" y="270" /></Array></mxGeometry></mxCell><mxCell id="n17" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;health&lt;br&gt;estimate&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#b45309;labelBackgroundColor=#ffffff;exitX=0;exitY=1;entryX=0.5;entryY=0;" edge="1" source="n5" target="n10" parent="n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="260" /><mxPoint x="180" y="260" /></Array></mxGeometry></mxCell><mxCell id="n18" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;safety action&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#b45309;labelBackgroundColor=#ffffff;" edge="1" source="n10" target="n9" parent="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n19" value="&lt;b&gt;Why it feels instantaneous&lt;/b&gt;&lt;br&gt;&lt;br&gt;These are scheduled feedback calculations on local hardware. Crazyswarm reports an onboard 500 Hz loop (2 ms period) for its indoor platform.&lt;br&gt;EGO-Swarm reports millisecond trajectory optimization in its experiments. Neither is a universal outdoor operating rate." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="765" width="1420" height="100" as="geometry" /></mxCell><mxCell id="n20" value="Sources: docs.px4.io/main/en/flight_stack/controller_diagrams • whoenig.github.io/publications/2016_IROS-LateBreaking_Preiss.pdf • arxiv.org/abs/2011.04183" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#64748b;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="875" width="1420" height="48" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="swarm-page-3" name="03 Communication"><mxGraphModel dx="1500" dy="940" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="940" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="2 / COMMUNICATION: STATE, INTENT AND EVENTS" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#0f172a;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="52" as="geometry" /></mxCell><mxCell id="n2" value="Communication supports coordination. Onboard stabilization never waits for a cloud response." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#475569;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1420" height="46" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;Drone A&lt;/b&gt;&lt;br&gt;&lt;br&gt;Local sensors + own state estimate&lt;br&gt;Current task + short future trajectory&lt;br&gt;Onboard control and contingency" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="400" height="170" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Nearby Drone B / C / …&lt;/b&gt;&lt;br&gt;&lt;br&gt;Receive relevant neighbor intent&lt;br&gt;Predict separation over time&lt;br&gt;Replan with local sensing" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="1060" y="180" width="400" height="170" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;Shared compact message&lt;/b&gt;&lt;br&gt;&lt;br&gt;ID + timestamp + coordinate frame&lt;br&gt;Position + velocity + uncertainty&lt;br&gt;Planned trajectory + validity&lt;br&gt;Health + energy estimate + task" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="550" y="155" width="400" height="220" as="geometry" /></mxCell><mxCell id="n6" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;publish&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#2563eb;labelBackgroundColor=#ffffff;" edge="1" source="n3" target="n5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n7" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;subscribe&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#2563eb;labelBackgroundColor=#ffffff;" edge="1" source="n5" target="n4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n8" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;own intent&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#2563eb;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" source="n4" target="n5" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="415" /><mxPoint x="750" y="415" /></Array></mxGeometry></mxCell><mxCell id="n9" value="&lt;b&gt;Local field radio / gateway&lt;/b&gt;&lt;br&gt;&lt;br&gt;Direct radio, routed mesh or LTE&lt;br&gt;Prioritize command / alert traffic&lt;br&gt;Bound neighbor discovery + message load&lt;br&gt;Persist critical events while offline" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="550" y="495" width="400" height="180" as="geometry" /></mxCell><mxCell id="n10" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;status +&lt;br&gt;observations&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#2563eb;labelBackgroundColor=#ffffff;" edge="1" source="n5" target="n9" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n11" value="&lt;b&gt;Field mission coordinator&lt;/b&gt;&lt;br&gt;&lt;br&gt;Task progress + aircraft availability&lt;br&gt;Confirmed detections + coverage&lt;br&gt;New tasks / assignment changes&lt;br&gt;Scope, identity and expiry checks" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="495" width="400" height="180" as="geometry" /></mxCell><mxCell id="n12" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;events&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;" edge="1" source="n9" target="n11" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n13" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;mission&lt;br&gt;commands&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" source="n11" target="n9" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="725" /><mxPoint x="750" y="725" /></Array></mxGeometry></mxCell><mxCell id="n14" value="&lt;b&gt;Separate media path&lt;/b&gt;&lt;br&gt;&lt;br&gt;Record imagery onboard&lt;br&gt;Send detections + evidence references&lt;br&gt;Stream selected cameras only&lt;br&gt;Do not flood control links with video" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="1060" y="495" width="400" height="180" as="geometry" /></mxCell><mxCell id="n15" value="&lt;b&gt;Stale-data handling&lt;/b&gt;&lt;br&gt;&lt;br&gt;Late neighbor messages increase uncertainty. Reject expired intent and follow the validated local contingency when safe planning is no longer possible.&lt;br&gt;A radio mesh supplies connectivity; algorithms, timing checks and local sensing supply coordination." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="1420" height="95" as="geometry" /></mxCell><mxCell id="n16" value="Research basis: EGO-Swarm (arxiv.org/abs/2011.04183); Swarm-LIO2 (arxiv.org/abs/2409.17798). Topology and link capacity are design choices requiring measurement." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#64748b;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="875" width="1420" height="48" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="swarm-page-4" name="04 Failure recovery"><mxGraphModel dx="1500" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="1100" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="3 / FAILURE: PROTECT FLIGHT, THEN RECOVER WORK" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#0f172a;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="52" as="geometry" /></mxCell><mxCell id="n2" value="Example: D17 stops reporting during flood search. Missing telemetry does not establish a crash." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#475569;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1420" height="46" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;&lt;br&gt;Heartbeat / task update missing&lt;br&gt;Or explicit onboard fault reported&lt;br&gt;Last known position retained" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fff1f2;strokeColor=#be123c;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="370" height="130" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Classify state&lt;/b&gt;&lt;br&gt;&lt;br&gt;Unreachable / degraded / failed&lt;br&gt;Check radio, navigation and health&lt;br&gt;Do not mark available automatically" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fff1f2;strokeColor=#be123c;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="565" y="170" width="370" height="130" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;Protect nearby aircraft&lt;/b&gt;&lt;br&gt;&lt;br&gt;Local sensing and trajectory checks&lt;br&gt;Keep clear of uncertain flight region&lt;br&gt;Use validated contingency" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="1090" y="170" width="370" height="130" as="geometry" /></mxCell><mxCell id="n6" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;status age /&lt;br&gt;fault&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#be123c;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#be123c;labelBackgroundColor=#ffffff;" edge="1" source="n3" target="n4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n7" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;possible&lt;br&gt;physical&lt;br&gt;hazard&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#be123c;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#be123c;labelBackgroundColor=#ffffff;" edge="1" source="n4" target="n5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;Preserve task history&lt;/b&gt;&lt;br&gt;&lt;br&gt;Assigned task and generation&lt;br&gt;Completed strips / last observations&lt;br&gt;Any release / delivery evidence&lt;br&gt;Task execution may be unknown" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="565" y="390" width="370" height="165" as="geometry" /></mxCell><mxCell id="n9" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;durable&lt;br&gt;record&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#be123c;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#be123c;labelBackgroundColor=#ffffff;" edge="1" source="n4" target="n8" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;Unfinished search&lt;/b&gt;&lt;br&gt;&lt;br&gt;Confirm release / safe quiescence&lt;br&gt;Avoid conflicting flight assignments&lt;br&gt;Reassign remaining strips only" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="370" height="160" as="geometry" /></mxCell><mxCell id="n11" value="&lt;b&gt;Uncertain delivery&lt;/b&gt;&lt;br&gt;&lt;br&gt;Was payload released or received?&lt;br&gt;Seek evidence / human confirmation&lt;br&gt;Do not blindly repeat the operation" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="565" y="640" width="370" height="160" as="geometry" /></mxCell><mxCell id="n12" value="&lt;b&gt;Replacement selection&lt;/b&gt;&lt;br&gt;&lt;br&gt;Capability + urgency + ETA&lt;br&gt;Energy to work and recover&lt;br&gt;Valid flight / landing capacity" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="1090" y="640" width="370" height="160" as="geometry" /></mxCell><mxCell id="n13" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;search task&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;exitX=0;exitY=1;entryX=0.5;entryY=0;" edge="1" source="n8" target="n10" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="590" /><mxPoint x="225" y="590" /></Array></mxGeometry></mxCell><mxCell id="n14" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;delivery task&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#b45309;labelBackgroundColor=#ffffff;" edge="1" source="n8" target="n11" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n15" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;eligible&lt;br&gt;remaining&lt;br&gt;work&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" source="n10" target="n12" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="225" y="855" /><mxPoint x="1275" y="855" /></Array></mxGeometry></mxCell><mxCell id="n16" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;verify&lt;br&gt;outcome and&lt;br&gt;conflict&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#b45309;labelBackgroundColor=#ffffff;" edge="1" source="n11" target="n12" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n17" value="&lt;b&gt;The physical limit&lt;/b&gt;&lt;br&gt;&lt;br&gt;Work can be redistributed after safe ownership resolution. A catastrophic mechanical failure may still cause a crash.&lt;br&gt;Lost contact, low energy, navigation loss and motor failure require different detection and contingency handling." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fff1f2;strokeColor=#be123c;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1420" height="105" as="geometry" /></mxCell><mxCell id="n18" value="Research basis: onboard failsafes (docs.px4.io/main/en/config/safety); distributed allocation (MIT CBBA paper). Recovery flow is an engineering proposal." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#64748b;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1035" width="1420" height="48" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="swarm-page-5" name="05 Energy budget"><mxGraphModel dx="1500" dy="1060" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="1060" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="4 / BATTERY: MEASURE, PREDICT, FILTER, ROTATE" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#0f172a;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="52" as="geometry" /></mxCell><mxCell id="n2" value="Use a conservative energy estimate for the route and task. Battery percentage alone is not mission feasibility." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#475569;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1420" height="46" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;Measure usable energy&lt;/b&gt;&lt;br&gt;&lt;br&gt;Calibrated voltage + current sensing&lt;br&gt;Consumed energy ≈ integral of V × I&lt;br&gt;Capacity / temperature / ageing&lt;br&gt;Estimate uncertainty" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="410" height="170" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Predict required energy&lt;/b&gt;&lt;br&gt;&lt;br&gt;Travel to task + perform work&lt;br&gt;Reach safe recovery + pad wait&lt;br&gt;Payload / wind / route conditions&lt;br&gt;Contingency reserve" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="545" y="170" width="410" height="170" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;Feasibility test&lt;/b&gt;&lt;br&gt;&lt;br&gt;Usable remaining energy ≥&lt;br&gt;travel + work + recovery + reserve&lt;br&gt;Reject infeasible assignments&lt;br&gt;Recompute during the sortie" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="1050" y="170" width="410" height="170" as="geometry" /></mxCell><mxCell id="n6" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;current&lt;br&gt;estimate&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#b45309;labelBackgroundColor=#ffffff;" edge="1" source="n3" target="n4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n7" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;conservative&lt;br&gt;budget&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#b45309;labelBackgroundColor=#ffffff;" edge="1" source="n4" target="n5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;Illustrative allocation&lt;/b&gt;&lt;br&gt;&lt;br&gt;D8: 80 Wh usable; task needs 90 Wh&lt;br&gt;→ reject this assignment&lt;br&gt;D23: 80 Wh usable; task needs 65 Wh&lt;br&gt;→ eligible if other constraints pass" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="410" height="175" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;Plan continuity&lt;/b&gt;&lt;br&gt;&lt;br&gt;Assign replacement before recovery&lt;br&gt;Reserve safe landing / pad capacity&lt;br&gt;Check return route and alternate&lt;br&gt;Notify allocator of declining margin" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="545" y="440" width="410" height="175" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;Onboard fallback&lt;/b&gt;&lt;br&gt;&lt;br&gt;Energy margin triggers recovery&lt;br&gt;Battery failsafe remains local&lt;br&gt;Navigation / weather may change plan&lt;br&gt;Never rely on cloud response" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="1050" y="440" width="410" height="175" as="geometry" /></mxCell><mxCell id="n11" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;during flight&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c3aed;labelBackgroundColor=#ffffff;" edge="1" source="n5" target="n10" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n12" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;eligibility /&lt;br&gt;recovery&lt;br&gt;forecast&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;exitX=0;exitY=1;entryX=0.5;entryY=0;" edge="1" source="n5" target="n9" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="390" /><mxPoint x="750" y="390" /></Array></mxGeometry></mxCell><mxCell id="n13" value="&lt;b&gt;Ground rotation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Recover → inspect → swap pack&lt;br&gt;Cool / charge → verify → relaunch&lt;br&gt;Track pack identity and health&lt;br&gt;Charging power and crew are finite" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="545" y="735" width="410" height="170" as="geometry" /></mxCell><mxCell id="n14" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;sortie&lt;br&gt;handoff&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#b45309;labelBackgroundColor=#ffffff;" edge="1" source="n9" target="n13" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n15" value="Illustrative numbers are not specifications. Reserve and flight envelope must be validated for the actual aircraft." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#475569;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="1420" height="30" as="geometry" /></mxCell><mxCell id="n16" value="Sources: ArduPilot battery-monitor documentation; arxiv.org/abs/2209.06308 (uncertain energy and recharge allocation)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#64748b;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="995" width="1420" height="48" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="swarm-page-6" name="06 Surveillance allocation"><mxGraphModel dx="1500" dy="1040" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="1040" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="5 / PERSISTENT SURVEILLANCE AND RESOURCE ALLOCATION" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#0f172a;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="52" as="geometry" /></mxCell><mxCell id="n2" value="Flood example: patches near villages receive more frequent revisits; uncertain detections create verification tasks." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#475569;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1420" height="46" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;1  Partition the area&lt;/b&gt;&lt;br&gt;&lt;br&gt;Search strips / patches&lt;br&gt;Risk and access constraints&lt;br&gt;Approved operating volumes" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="410" height="150" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;2  Track information age&lt;/b&gt;&lt;br&gt;&lt;br&gt;Time of last useful observation&lt;br&gt;Detection confidence + coverage&lt;br&gt;Changed water / terrain conditions" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="545" y="170" width="410" height="150" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;3  Generate work&lt;/b&gt;&lt;br&gt;&lt;br&gt;Search unobserved areas&lt;br&gt;Revisit stale / high-risk patches&lt;br&gt;Verify possible stranded people" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="1050" y="170" width="410" height="150" as="geometry" /></mxCell><mxCell id="n6" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;coverage&lt;br&gt;ledger&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;" edge="1" source="n3" target="n4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n7" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;priority +&lt;br&gt;uncertainty&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;" edge="1" source="n4" target="n5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;4  Filter + allocate&lt;/b&gt;&lt;br&gt;&lt;br&gt;Capability + energy feasibility&lt;br&gt;ETA + urgency + flight constraints&lt;br&gt;Bounded optimizer OR distributed auction&lt;br&gt;One valid owner for exclusive work" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="1050" y="455" width="410" height="175" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;5  Execute locally&lt;/b&gt;&lt;br&gt;&lt;br&gt;Search / verify / approved delivery&lt;br&gt;Observe and record evidence&lt;br&gt;Local planning + flight control&lt;br&gt;Report progress as events" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="545" y="455" width="410" height="175" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;6  Update outcomes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Completed strip / new detection&lt;br&gt;Task failure / energy forecast&lt;br&gt;Observation age and confidence&lt;br&gt;Replan when useful" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="455" width="410" height="175" as="geometry" /></mxCell><mxCell id="n11" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;task queue&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;" edge="1" source="n5" target="n8" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n12" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;assigned task&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;" edge="1" source="n8" target="n9" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n13" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;progress +&lt;br&gt;observations&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#2563eb;labelBackgroundColor=#ffffff;" edge="1" source="n9" target="n10" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n14" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;update /&lt;br&gt;repeat&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" source="n10" target="n4" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="245" y="390" /><mxPoint x="750" y="390" /></Array></mxGeometry></mxCell><mxCell id="n15" value="&lt;b&gt;What triggers a new assignment?&lt;/b&gt;&lt;br&gt;&lt;br&gt;New urgent detection • aircraft unavailable • energy margin shrinking • finished strip • fresh weather / airspace constraint&lt;br&gt;Flight controllers continue at their own rate while this slower mission loop runs. Avoid reassignment thrashing." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1420" height="115" as="geometry" /></mxCell><mxCell id="n16" value="&lt;b&gt;Response outcomes remain distinct&lt;/b&gt;&lt;br&gt;&lt;br&gt;A camera candidate is not a confirmed survivor. Package release is not confirmed receipt. Receipt is not extraction.&lt;br&gt;Ground teams and human review close the relevant incident outcome." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="875" width="1420" height="85" as="geometry" /></mxCell><mxCell id="n17" value="Sources: CBBA (MIT 2009); arxiv.org/abs/1908.05727 (energy-constrained persistent surveillance). Layout is a proposed humanitarian system, not a measured 50-drone deployment." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#64748b;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="975" width="1420" height="48" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>