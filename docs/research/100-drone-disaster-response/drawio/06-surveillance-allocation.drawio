<?xml version='1.0' encoding='utf-8'?>
<mxGraphModel dx="1500" dy="1040" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="1040" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="5 / PERSISTENT SURVEILLANCE AND RESOURCE ALLOCATION" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#0f172a;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="52" as="geometry" /></mxCell><mxCell id="n2" value="Flood example: patches near villages receive more frequent revisits; uncertain detections create verification tasks." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#475569;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1420" height="46" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;1  Partition the area&lt;/b&gt;&lt;br&gt;&lt;br&gt;Search strips / patches&lt;br&gt;Risk and access constraints&lt;br&gt;Approved operating volumes" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="410" height="150" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;2  Track information age&lt;/b&gt;&lt;br&gt;&lt;br&gt;Time of last useful observation&lt;br&gt;Detection confidence + coverage&lt;br&gt;Changed water / terrain conditions" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="545" y="170" width="410" height="150" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;3  Generate work&lt;/b&gt;&lt;br&gt;&lt;br&gt;Search unobserved areas&lt;br&gt;Revisit stale / high-risk patches&lt;br&gt;Verify possible stranded people" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="1050" y="170" width="410" height="150" as="geometry" /></mxCell><mxCell id="n6" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;coverage&lt;br&gt;ledger&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;" edge="1" source="n3" target="n4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n7" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;priority +&lt;br&gt;uncertainty&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;" edge="1" source="n4" target="n5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;4  Filter + allocate&lt;/b&gt;&lt;br&gt;&lt;br&gt;Capability + energy feasibility&lt;br&gt;ETA + urgency + flight constraints&lt;br&gt;Bounded optimizer OR distributed auction&lt;br&gt;One valid owner for exclusive work" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="1050" y="455" width="410" height="175" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;5  Execute locally&lt;/b&gt;&lt;br&gt;&lt;br&gt;Search / verify / approved delivery&lt;br&gt;Observe and record evidence&lt;br&gt;Local planning + flight control&lt;br&gt;Report progress as events" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="545" y="455" width="410" height="175" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;6  Update outcomes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Completed strip / new detection&lt;br&gt;Task failure / energy forecast&lt;br&gt;Observation age and confidence&lt;br&gt;Replan when useful" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="455" width="410" height="175" as="geometry" /></mxCell><mxCell id="n11" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;task queue&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;" edge="1" source="n5" target="n8" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n12" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;assigned task&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;" edge="1" source="n8" target="n9" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n13" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;progress +&lt;br&gt;observations&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#2563eb;labelBackgroundColor=#ffffff;" edge="1" source="n9" target="n10" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n14" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;update /&lt;br&gt;repeat&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" source="n10" target="n4" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="245" y="390" /><mxPoint x="750" y="390" /></Array></mxGeometry></mxCell><mxCell id="n15" value="&lt;b&gt;What triggers a new assignment?&lt;/b&gt;&lt;br&gt;&lt;br&gt;New urgent detection • aircraft unavailable • energy margin shrinking • finished strip • fresh weather / airspace constraint&lt;br&gt;Flight controllers continue at their own rate while this slower mission loop runs. Avoid reassignment thrashing." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1420" height="115" as="geometry" /></mxCell><mxCell id="n16" value="&lt;b&gt;Response outcomes remain distinct&lt;/b&gt;&lt;br&gt;&lt;br&gt;A camera candidate is not a confirmed survivor. Package release is not confirmed receipt. Receipt is not extraction.&lt;br&gt;Ground teams and human review close the relevant incident outcome." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="875" width="1420" height="85" as="geometry" /></mxCell><mxCell id="n17" value="Sources: CBBA (MIT 2009); arxiv.org/abs/1908.05727 (energy-constrained persistent surveillance). Layout is a proposed humanitarian system, not a measured 50-drone deployment." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#64748b;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="975" width="1420" height="48" as="geometry" /></mxCell></root></mxGraphModel>