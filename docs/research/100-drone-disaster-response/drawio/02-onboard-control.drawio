<mxGraphModel dx="1500" dy="940" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="940" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="1 / ONBOARD FEEDBACK AND LOCAL PLANNING" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#0f172a;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="52" as="geometry" /></mxCell><mxCell id="n2" value="Every aircraft executes this stack independently. A task is a goal; motor commands come from local control." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#475569;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1420" height="46" as="geometry" /></mxCell><mxCell id="n3" value="AIRCRAFT COMPUTE BOUNDARY" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;container=1;collapsible=0;fillColor=#faf5ff;swimlaneFillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#7c3aed;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="1420" height="580" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Sensor acquisition&lt;/b&gt;&lt;br&gt;&lt;br&gt;IMU: acceleration + angular rate&lt;br&gt;GNSS / vision: position cues&lt;br&gt;Depth / camera: obstacles" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="30" y="85" width="300" height="145" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;State estimator&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fuse imperfect measurements&lt;br&gt;Estimate position, velocity, attitude&lt;br&gt;Track uncertainty and sensor health" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="380" y="85" width="300" height="145" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;Local trajectory optimizer&lt;/b&gt;&lt;br&gt;&lt;br&gt;Goal + local map + neighbor paths&lt;br&gt;Short-horizon feasible trajectory&lt;br&gt;Execute a portion, then replan" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="730" y="85" width="300" height="145" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;Neighbor exchange&lt;/b&gt;&lt;br&gt;&lt;br&gt;Receive planned trajectories&lt;br&gt;Timestamp + coordinate frame&lt;br&gt;Age and uncertainty matter" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="1080" y="85" width="300" height="145" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;Cascaded flight controller&lt;/b&gt;&lt;br&gt;&lt;br&gt;Position error → desired velocity&lt;br&gt;Velocity error → thrust / attitude&lt;br&gt;Attitude error → angular rate" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="730" y="320" width="300" height="150" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;Rate loop + motor allocation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Angular-rate tracking corrections&lt;br&gt;Translate thrust / torque to motors&lt;br&gt;Physical motion closes the loop" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="380" y="320" width="300" height="150" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;Independent safety logic&lt;/b&gt;&lt;br&gt;&lt;br&gt;Battery / position / link health&lt;br&gt;Configured hold / recovery / land&lt;br&gt;Mission-specific contingency" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="30" y="320" width="300" height="150" as="geometry" /></mxCell><mxCell id="n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c3aed;labelBackgroundColor=#ffffff;" edge="1" source="n4" target="n5" parent="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c3aed;labelBackgroundColor=#ffffff;" edge="1" source="n5" target="n6" parent="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c3aed;labelBackgroundColor=#ffffff;" edge="1" source="n7" target="n6" parent="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c3aed;labelBackgroundColor=#ffffff;" edge="1" source="n6" target="n8" parent="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c3aed;labelBackgroundColor=#ffffff;" edge="1" source="n8" target="n9" parent="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n16" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;motion →&lt;br&gt;measurements&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c3aed;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" source="n9" target="n4" parent="n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="490" /><mxPoint x="355" y="270" /><mxPoint x="180" y="270" /></Array></mxGeometry></mxCell><mxCell id="n17" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;health&lt;br&gt;estimate&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#b45309;labelBackgroundColor=#ffffff;exitX=0;exitY=1;entryX=0.5;entryY=0;" edge="1" source="n5" target="n10" parent="n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="260" /><mxPoint x="180" y="260" /></Array></mxGeometry></mxCell><mxCell id="n18" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;safety action&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#b45309;labelBackgroundColor=#ffffff;" edge="1" source="n10" target="n9" parent="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n19" value="&lt;b&gt;Why it feels instantaneous&lt;/b&gt;&lt;br&gt;&lt;br&gt;These are scheduled feedback calculations on local hardware. Crazyswarm reports an onboard 500 Hz loop (2 ms period) for its indoor platform.&lt;br&gt;EGO-Swarm reports millisecond trajectory optimization in its experiments. Neither is a universal outdoor operating rate." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="765" width="1420" height="100" as="geometry" /></mxCell><mxCell id="n20" value="Sources: docs.px4.io/main/en/flight_stack/controller_diagrams • whoenig.github.io/publications/2016_IROS-LateBreaking_Preiss.pdf • arxiv.org/abs/2011.04183" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#64748b;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="875" width="1420" height="48" as="geometry" /></mxCell></root></mxGraphModel>