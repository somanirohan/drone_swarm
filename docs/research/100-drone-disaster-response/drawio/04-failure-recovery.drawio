<?xml version='1.0' encoding='utf-8'?>
<mxGraphModel dx="1500" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="1100" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="3 / FAILURE: PROTECT FLIGHT, THEN RECOVER WORK" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#0f172a;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="52" as="geometry" /></mxCell><mxCell id="n2" value="Example: D17 stops reporting during flood search. Missing telemetry does not establish a crash." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#475569;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1420" height="46" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;&lt;br&gt;Heartbeat / task update missing&lt;br&gt;Or explicit onboard fault reported&lt;br&gt;Last known position retained" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fff1f2;strokeColor=#be123c;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="370" height="130" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Classify state&lt;/b&gt;&lt;br&gt;&lt;br&gt;Unreachable / degraded / failed&lt;br&gt;Check radio, navigation and health&lt;br&gt;Do not mark available automatically" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fff1f2;strokeColor=#be123c;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="565" y="170" width="370" height="130" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;Protect nearby aircraft&lt;/b&gt;&lt;br&gt;&lt;br&gt;Local sensing and trajectory checks&lt;br&gt;Keep clear of uncertain flight region&lt;br&gt;Use validated contingency" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="1090" y="170" width="370" height="130" as="geometry" /></mxCell><mxCell id="n6" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;status age /&lt;br&gt;fault&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#be123c;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#be123c;labelBackgroundColor=#ffffff;" edge="1" source="n3" target="n4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n7" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;possible&lt;br&gt;physical&lt;br&gt;hazard&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#be123c;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#be123c;labelBackgroundColor=#ffffff;" edge="1" source="n4" target="n5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;Preserve task history&lt;/b&gt;&lt;br&gt;&lt;br&gt;Assigned task and generation&lt;br&gt;Completed strips / last observations&lt;br&gt;Any release / delivery evidence&lt;br&gt;Task execution may be unknown" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="565" y="390" width="370" height="165" as="geometry" /></mxCell><mxCell id="n9" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;durable&lt;br&gt;record&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#be123c;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#be123c;labelBackgroundColor=#ffffff;" edge="1" source="n4" target="n8" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;Unfinished search&lt;/b&gt;&lt;br&gt;&lt;br&gt;Confirm release / safe quiescence&lt;br&gt;Avoid conflicting flight assignments&lt;br&gt;Reassign remaining strips only" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="370" height="160" as="geometry" /></mxCell><mxCell id="n11" value="&lt;b&gt;Uncertain delivery&lt;/b&gt;&lt;br&gt;&lt;br&gt;Was payload released or received?&lt;br&gt;Seek evidence / human confirmation&lt;br&gt;Do not blindly repeat the operation" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="565" y="640" width="370" height="160" as="geometry" /></mxCell><mxCell id="n12" value="&lt;b&gt;Replacement selection&lt;/b&gt;&lt;br&gt;&lt;br&gt;Capability + urgency + ETA&lt;br&gt;Energy to work and recover&lt;br&gt;Valid flight / landing capacity" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="1090" y="640" width="370" height="160" as="geometry" /></mxCell><mxCell id="n13" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;search task&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;exitX=0;exitY=1;entryX=0.5;entryY=0;" edge="1" source="n8" target="n10" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="590" /><mxPoint x="225" y="590" /></Array></mxGeometry></mxCell><mxCell id="n14" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;delivery task&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#b45309;labelBackgroundColor=#ffffff;" edge="1" source="n8" target="n11" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n15" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;eligible&lt;br&gt;remaining&lt;br&gt;work&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" source="n10" target="n12" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="225" y="855" /><mxPoint x="1275" y="855" /></Array></mxGeometry></mxCell><mxCell id="n16" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;verify&lt;br&gt;outcome and&lt;br&gt;conflict&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#b45309;labelBackgroundColor=#ffffff;" edge="1" source="n11" target="n12" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n17" value="&lt;b&gt;The physical limit&lt;/b&gt;&lt;br&gt;&lt;br&gt;Work can be redistributed after safe ownership resolution. A catastrophic mechanical failure may still cause a crash.&lt;br&gt;Lost contact, low energy, navigation loss and motor failure require different detection and contingency handling." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fff1f2;strokeColor=#be123c;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1420" height="105" as="geometry" /></mxCell><mxCell id="n18" value="Research basis: onboard failsafes (docs.px4.io/main/en/config/safety); distributed allocation (MIT CBBA paper). Recovery flow is an engineering proposal." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#64748b;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1035" width="1420" height="48" as="geometry" /></mxCell></root></mxGraphModel>