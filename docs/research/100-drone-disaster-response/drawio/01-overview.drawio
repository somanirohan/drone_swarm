" y="555" width="365" height="470" as="geometry" /></mxCell><mxCell id="n15" value="5  TASKS + COVERAGE" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;container=1;collapsible=0;fillColor=#f0fdfa;swimlaneFillColor=#ffffff;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#0f766e;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="425" y="555" width="365" height="470" as="geometry" /></mxCell><mxCell id="n16" value="4  ENERGY + ROTATION" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;container=1;collapsible=0;fillColor=#fffbeb;swimlaneFillColor=#ffffff;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#b45309;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="810" y="555" width="365" height="470" as="geometry" /></mxCell><mxCell id="n17" value="3  FAILURE RECOVERY" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;container=1;collapsible=0;fillColor=#fff1f2;swimlaneFillColor=#ffffff;strokeColor=#be123c;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#be123c;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="1195" y="555" width="365" height="470" as="geometry" /></mxCell><mxCell id="n18" value="&lt;b&gt;Compact state + intent&lt;/b&gt;&lt;br&gt;&lt;br&gt;ID + timestamp&lt;br&gt;Position / velocity + uncertainty&lt;br&gt;Short planned trajectory&lt;br&gt;Health + energy + task" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n14"><mxGeometry x="20" y="70" width="325" height="180" as="geometry" /></mxCell><mxCell id="n19" value="&lt;b&gt;Radio links&lt;/b&gt;&lt;br&gt;&lt;br&gt;Neighbors: collision-relevant data&lt;br&gt;Gateway: status + observations&lt;br&gt;Video: local / selected upload&lt;br&gt;Reject stale state; bound traffic" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n14"><mxGeometry x="20" y="280" width="325" height="145" as="geometry" /></mxCell><mxCell id="n20" value="&lt;b&gt;Event-driven allocator&lt;/b&gt;&lt;br&gt;&lt;br&gt;Divide area into search patches&lt;br&gt;Rank urgency + observation age&lt;br&gt;Filter capability + energy&lt;br&gt;Assign remaining feasible work" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n15"><mxGeometry x="20" y="70" width="325" height="180" as="geometry" /></mxCell><mxCell id="n21" value="&lt;b&gt;Outcome + coverage ledger&lt;/b&gt;&lt;br&gt;&lt;br&gt;Track completed search strips&lt;br&gt;Record detection confidence&lt;br&gt;Revisit uncertain observations&lt;br&gt;Prevent conflicting assignments" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n15"><mxGeometry x="20" y="280" width="325" height="145" as="geometry" /></mxCell><mxCell id="n22" value="&lt;b&gt;Energy feasibility&lt;/b&gt;&lt;br&gt;&lt;br&gt;Remaining usable energy ≥&lt;br&gt;travel + work + recovery&lt;br&gt;+ contingency reserve&lt;br&gt;Account for wind / payload" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n16"><mxGeometry x="20" y="70" width="325" height="180" as="geometry" /></mxCell><mxCell id="n23" value="&lt;b&gt;Maintain coverage&lt;/b&gt;&lt;br&gt;&lt;br&gt;Schedule replacement before return&lt;br&gt;Reserve recovery / pad capacity&lt;br&gt;Swap, cool, charge and inspect&lt;br&gt;Onboard battery failsafe" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n16"><mxGeometry x="20" y="280" width="325" height="145" as="geometry" /></mxCell><mxCell id="n24" value="&lt;b&gt;Detect + classify&lt;/b&gt;&lt;br&gt;&lt;br&gt;Missing heartbeat → unreachable&lt;br&gt;Known fault → degraded / failed&lt;br&gt;Retain last position and task&lt;br&gt;Local aircraft handle hazards" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fff1f2;strokeColor=#be123c;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n17"><mxGeometry x="20" y="70" width="325" height="180" as="geometry" /></mxCell><mxCell id="n25" value="&lt;b&gt;Recover unfinished work&lt;/b&gt;&lt;br&gt;&lt;br&gt;Resolve execution conflict first&lt;br&gt;Reallocate unfinished search&lt;br&gt;Verify uncertain delivery outcome&lt;br&gt;Lost capacity ≠ guaranteed rescue" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fff1f2;strokeColor=#be123c;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n17"><mxGeometry x="20" y="280" width="325" height="145" as="geometry" /></mxCell><mxCell id="n26" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;neighbor&lt;br&gt;trajectories&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#2563eb;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.15;entryY=1;" edge="1" source="n18" target="n6" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="515" /><mxPoint x="790" y="515" /></Array></mxGeometry></mxCell><mxCell id="n27" value="&lt;div style=&quot;width:80px;text-align:center&quot;&gt;assigned goal&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.85;entryY=1;" edge="1" source="n20" target="n6" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="605" y="495" /><mxPoint x="865" y="495" /></Array></mxGeometry></mxCell><mxCell id="n28" value="ENERGY AND FAILURE EVENTS UPDATE ELIGIBILITY; THE FLIGHT LOOP KEEPS RUNNING" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#0f172a;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1045" width="1520" height="36" as="geometry" /></mxCell><mxCell id="n29" value="Architecture proposal. Exact rates, radio capacity and safety behavior require platform validation. Research: PX4, Crazyswarm, EGO-Swarm, CBBA and energy-constrained surveillance." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#64748b;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1105" width="1520" height="48" as="geometry" /></mxCell></root></mxGraphModel>