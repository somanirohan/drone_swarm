<mxGraphModel dx="1600" dy="1170" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1170" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="50-DRONE SWARM / REAL-TIME SYSTEM" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#0f172a;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="52" as="geometry" /></mxCell><mxCell id="n2" value="Five cooperating mechanisms. Flight stays local; mission coordination reacts to events. No LLM is required." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#475569;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1520" height="46" as="geometry" /></mxCell><mxCell id="n3" value="1  ON EVERY AIRCRAFT — continuous closed-loop control" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;container=1;collapsible=0;fillColor=#faf5ff;swimlaneFillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#7c3aed;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="1520" height="335" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Sensors&lt;/b&gt;&lt;br&gt;&lt;br&gt;IMU + GNSS&lt;br&gt;Camera / depth&lt;br&gt;Voltage + current" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="25" y="85" width="270" height="145" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;State estimation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sensor fusion&lt;br&gt;Position + velocity + attitude&lt;br&gt;Uncertainty + local map" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="325" y="85" width="270" height="145" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;Trajectory planning&lt;/b&gt;&lt;br&gt;&lt;br&gt;Predict nearby paths&lt;br&gt;Optimize a short horizon&lt;br&gt;Replan as inputs change" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="625" y="85" width="270" height="145" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;Flight controllers&lt;/b&gt;&lt;br&gt;&lt;br&gt;Position → velocity&lt;br&gt;Attitude → angular rate&lt;br&gt;Track desired trajectory" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="925" y="85" width="270" height="145" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;Actuators + motion&lt;/b&gt;&lt;br&gt;&lt;br&gt;Allocate motor outputs&lt;br&gt;Aircraft moves&lt;br&gt;Sensors measure again" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="n3"><mxGeometry x="1225" y="85" width="270" height="145" as="geometry" /></mxCell><mxCell id="n9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#7c3aed;labelBackgroundColor=#ffffff;" edge="1" source="n4" target="n5" parent="