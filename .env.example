# Copy to .env (git-ignored) and fill in. Never commit real values.

# Optional: TypeSafe Jev planner for the original PyBullet exercise (run-disaster.ps1 -AI jev)
TYPESAFE_API_KEY=

# Optional: fixed operator token for the operations server (otherwise generated on each start)
OPS_CONTROL_TOKEN=

# Optional: separate secret for the reserved external ground-update action
OPS_INTEGRATION_TOKEN=

# Public demo: anyone can control the simulation and issue API commands without tokens.
OPS_PUBLIC_DEMO=false

# Deployment (swarm_ops/config.py). Names only; no value is required locally.
HOST=
PORT=
ALLOWED_ORIGINS=
FLEET=
WORLD=
SEED=
SCENARIO=
LOG_LEVEL=
# Live reference data from DisruptionOps (optional; staff bearer JWT for /resources)
DISRUPTIONOPS_URL=
DISRUPTIONOPS_TOKEN=
